	</svg>
	<ContainerSection>
		<div class="typewriter-wrap">
			<TypewriterYaml sources={sources} filenames={filenames} />
		</div>
	</ContainerSection>
</StarlightPage>

<style>
	/* Single-fold hero: copy sits around 1/3 of the page height; a shorter
	   terminal (about 60% of its full height) sits below it and scrolls
	   internally, so the page never scrolls itself. */
	:global(.container-section .container-wrapper) {
		max-width: 80rem;
	}

	/* Pin the fold to the viewport so flex-shrink (not page growth) absorbs any
	   tight-viewport overflow — the page can never scroll. */
	:global([data-slot='layout']) {
		height: 100svh;
		/* Faint square grid across the whole background. color-mix on the theme
		   foreground keeps it subtle in both light and dark mode. */
		background-image:
			linear-gradient(to right, color-mix(in oklab, var(--foreground) 7%, transparent) 1px, transparent 1px),
			linear-gradient(to bottom, color-mix(in oklab, var(--foreground) 7%, transparent) 1px, transparent 1px);
		background-size: 5.2rem 5.2rem;
	}

	/* Decorative site-index curves behind the content, adaptive-faint like the grid. */
	.bg-curves {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		width: 100%;
		height: 100%;
	}
	.bg-curves path {
		fill: none;
		stroke: currentColor;
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
		opacity: 0.08;
	}
	/* Dots sit on the curves at each grid line; created by JS in the same SVG so
	   they share the curves' transform and land exactly on the lines. */
	:global(.bg-curves ellipse) {
		fill: currentColor;
		opacity: 0.25;
	}

	:global(main main) {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-height: 0;
		padding: 0;
	}

	/* Hero section pinned to the upper third; the copy is pushed to its bottom so
	   the text block sits around 1/3 of the page height. */
	:global(.container-section:not(:has(.tty))) {
		flex: 0 0 auto;
		min-height: 0;
		height: calc(33.33svh - var(--header-height));
		display: flex;
		flex-direction: column;
	}

	:global(.container-section:not(:has(.tty)) .container-wrapper),
	:global(.container-section:not(:has(.tty)) .container) {
		flex: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
	}

	:global(.hero) {
		align-items: flex-start;
		justify-content: flex-start;
		margin-top: auto;
		padding-block: 1.5rem 2rem;
	}

	:global(.hero-info) {
		max-width: 40rem;
		text-align: left;
		align-items: flex-start;
	}

	:global(.hero-title-container),
	:global(.hero-content-container) {
		align-items: flex-start;
	}

	:global(.hero .actions) {
		justify-content: flex-start;
	}

	/* Terminal: fixed 60% height just below the copy; the code window scrolls
	   internally like a terminal. */
	:global(main main .markdown-wrapper),
	:global(main main .sl-markdown-content),
	:global(.container-section:has(.tty)),
	:global(.container-section:has(.tty) .container-wrapper),
	:global(.container-section:has(.tty) .container) {
		flex: 0 1 auto;
		min-height: 0;
		display: flex;
		flex-direction: column;
	}

	.typewriter-wrap {
		flex: 0 1 auto;
		min-height: 0;
		display: flex;
		flex-direction: column;
		max-width: 44rem;
		margin: 0;
		/* 60% of the terminal's full (1/3 → footer) height; copy bottom stays at ~1/3. */
		height: calc(40svh - 3.6rem);
		padding-block-end: 1.5rem;
		--tty-code-height: auto;
	}

	:global(.typewriter-wrap .tty) {
		flex: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
	}

	:global(.typewriter-wrap .tty-code) {
		flex: 1;
		min-height: 0;
	}

	/* Single-fold page: never scrolls. */
	:global(html) {
		overflow: clip;
	}
</style>

<script>
	// Site-index curve dots: on each curve, place a point at every vertical grid
	// line (x = grid boundary, y = curve value). Params must match the SVG paths.
	const bh = 0.15;
	const k = 3.4;
	const c = 1.35;
	const As = [0.5, 0.62, 0.74, 0.85, 0.95];

	const layout = document.querySelector('[data-slot="layout"]');
	const NS = 'http://www.w3.org/2000/svg';

	if (layout) {
		const draw = () => {
			const svg = document.querySelector('.bg-curves');
			if (!svg) return;
			svg.querySelectorAll('ellipse').forEach((e) => e.remove());

			const rect = svg.getBoundingClientRect();
			const cell = parseFloat(getComputedStyle(layout).backgroundSize.split(',')[0]);
			const xScale = rect.width / 100;
			const yScale = rect.height / 100;
			// Screen-space radius ~1.5px, counter-scaled so dots stay round.
			const rx = 1.5 / xScale;
			const ry = 1.5 / yScale;

			const frag = document.createDocumentFragment();
			for (let px = 0; px < rect.width; px += cell) {
				const vx = px / xScale; // viewBox x for this grid line
				const age = vx / 100;
				for (const A of As) {
					const h = bh + (A - bh) * Math.pow(1 - Math.exp(-k * age), c);
					const e = document.createElementNS(NS, 'ellipse');
					e.setAttribute('cx', vx);
					e.setAttribute('cy', 100 - h * 100);
					e.setAttribute('rx', rx);
					e.setAttribute('ry', ry);
					frag.appendChild(e);
				}
			}
			svg.appendChild(frag);
		};

		draw();
		let t;
		window.addEventListener('resize', () => {
			clearTimeout(t);
			t = setTimeout(draw, 150);
		});
	}
</script>
