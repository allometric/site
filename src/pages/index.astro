		template: 'splash',
		hero: {
			layout: 'centered',
			title: 'allometric',
			tagline:
				'Structured allometric models for trees.',
			actions: [
				{ text: 'Browse models', link: '/models/', variant: 'default' },
				{ text: 'Read the docs', link: '/guides/introduction/', variant: 'ghost' },
			],
		},
	}}
>
