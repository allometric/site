---
import { REPO, COMMIT, listPublications } from '../../lib/repo';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

// Generic publication page: one static shell per publication in the
// allometric/models repository. Content is fetched and rendered client-side
// at request time, so each page always shows the latest upstream YAML
// without a rebuild. Adding a new publication to the repo only requires
// rebuilding (getStaticPaths re-enumerates the tree).

export async function getStaticPaths() {
	return (await listPublications()).map(({ id, path }) => ({
		params: { pub_id: id },
		props: { pubPath: path },
	}));
}

const { pubPath } = Astro.props as { pubPath: string };
const pubId = Astro.params.pub_id;
const rawUrl = `https://raw.githubusercontent.com/${REPO}/${COMMIT}/${pubPath}`;
const githubUrl = `https://github.com/${REPO}/blob/${COMMIT}/${pubPath}`;
---

	<StarlightPage
		frontmatter={{
			title: pubId,
		}}
	>
	<div id="publication" class="publication" data-raw-url={rawUrl} data-pub-id={pubId} data-github-url={githubUrl}>
		<p id="status" class="status" role="status">Loading publication record…</p>
	</div>

	<footer class="source-note">
		<p>
			Rendered from{' '}
			<a href={`https://github.com/${REPO}/commit/${COMMIT}`} target="_blank" rel="noopener noreferrer">
				{REPO.split('/').pop()}@{COMMIT.slice(0, 7)}
			</a>
			:<a href={githubUrl} target="_blank" rel="noopener noreferrer">{pubId}.yaml</a>
		</p>
	</footer>
</StarlightPage>

	<style is:global>
		.status {
		color: var(--sl-color-gray-4);
	}
	/* Pub ids are machine identifiers: monospace keeps underscores solid and connected. */
	[data-slot='doc-title-header'] h1 {
		font-family: var(--sl-font-mono, var(--sl-font-system-mono));
		letter-spacing: normal;
	}
	.source-note a {
		font-family: var(--sl-font-mono, var(--sl-font-system-mono));
	}

	.status.error {
		color: var(--sl-color-red);
	}
	.source-note {
		color: var(--sl-color-gray-4);
		font-size: var(--sl-text-sm);
		margin-block-start: 1rem;
	}

	/* The in-body title is the page h1; hide StarlightPage's frontmatter h1 (pub_id). */
	body:has(#publication) [data-slot='doc-title-header'] {
		display: none;
	}
	#publication .pub-header {
		position: static;
	}
	.pub-title {
		font-size: var(--sl-text-3xl);
		margin-block: 0 0.5rem;
	}
	.pub-title a,
	.pub-meta a {
		color: var(--sl-color-text-accent);
	}
	#publication .pub-meta {
		color: var(--sl-color-gray-3);
		margin-block: 0 0.25rem;
	}
	/* Citation links: same color as surrounding citation text, underline only. */
	.pub-meta a {
		color: var(--sl-color-gray-3);
		text-decoration: underline;
	}
	.pub-line {
		color: var(--sl-color-gray-3);
		margin-block: 0.125rem;
		font-size: var(--sl-text-sm);
	}
	.pub-line .label {
		color: var(--sl-color-gray-2);
		font-weight: var(--sl-font-weight-semibold);
	}
	.expand {
		background: none;
		border: none;
		padding: 0 0.1rem;
		font: inherit;
		line-height: inherit;
		color: var(--sl-color-text-accent);
		cursor: pointer;
	}
	.badge {
		display: inline-block;
		margin-inline-start: 0.75rem;
		padding: 0.125rem 0.5rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		vertical-align: middle;
	}

	.model {
		border: 1px solid var(--sl-color-gray-6);
		border-radius: 0.5rem;
		padding: 1rem 1.25rem;
		margin-block-end: 1.5rem;
	}
	.model-head {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}
	.model-head .badge {
		margin-inline-start: auto;
	}
	.model-name {
		margin-block: 0 0.25rem;
	}
	.model-taxa,
	.model-vars {
		color: var(--sl-color-gray-3);
		margin-block: 0.25rem;
		font-size: var(--sl-text-sm);
	}
	.var-tip {
		border-block-end: 1px dotted var(--sl-color-gray-4);
		cursor: help;
		position: relative;
	}
	.var-tip.has-desc::after {
		content: attr(data-desc);
		position: absolute;
		left: 0;
		bottom: 135%;
		z-index: 20;
		width: max-content;
		max-width: 280px;
		background: var(--sl-color-bg, #fff);
		color: var(--sl-color-text);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		padding: 0.4rem 0.6rem;
		font-size: var(--sl-text-xs);
		font-weight: normal;
		line-height: 1.4;
		box-shadow: 0 2px 10px rgb(0 0 0 / 0.18);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 0.12s ease;
	}
	.var-tip.has-desc:hover::after,
	.var-tip.has-desc:focus-visible::after {
		opacity: 1;
		visibility: visible;
	}
	.type-badge {
		position: relative;
		text-transform: none;
		letter-spacing: normal;
		cursor: help;
		color: color-mix(in oklab, var(--tint) 58%, var(--sl-color-text));
		background: color-mix(in oklab, var(--tint) 16%, transparent);
		border-color: color-mix(in oklab, var(--tint) 40%, transparent);
	}
	.type-badge.model-type {
		--tint: var(--sl-color-accent);
	}
	.type-badge.set-type {
		--tint: #2fae88;
	}
	.type-badge.has-desc::after {
		content: attr(data-desc);
		position: absolute;
		left: 0;
		bottom: 135%;
		z-index: 20;
		width: max-content;
		max-width: 280px;
		background: var(--sl-color-bg, #fff);
		color: var(--sl-color-text);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		padding: 0.4rem 0.6rem;
		font-size: var(--sl-text-xs);
		font-weight: normal;
		line-height: 1.4;
		box-shadow: 0 2px 10px rgb(0 0 0 / 0.18);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 0.12s ease;
	}
	.type-badge.has-desc:hover::after,
	.type-badge.has-desc:focus-visible::after {
		opacity: 1;
		visibility: visible;
	}
	.code-tabs {
		border: 1px solid var(--sl-color-gray-6);
		border-radius: 0.375rem;
		overflow: hidden;
	}
	.code-tab-bar {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.375rem 0.5rem;
		background: var(--sl-color-gray-7);
		border-block-end: 1px solid var(--sl-color-gray-6);
	}
	.code-tab {
		display: inline-flex;
		align-items: center;
		margin: 0;
		background: transparent;
		border: none;
		border-radius: 0.25rem;
		padding: 0.15rem 0.6rem;
		font-family: inherit;
		font-size: var(--sl-text-xs);
		line-height: 1;
		font-weight: var(--sl-font-weight-semibold);
		color: var(--sl-color-gray-3);
		cursor: pointer;
		white-space: nowrap;
	}
	.code-tab:hover {
		color: var(--sl-color-text);
		background: color-mix(in oklab, var(--sl-color-gray-6) 40%, transparent);
	}
	.code-tab.active {
		color: var(--sl-color-accent-high);
		background: color-mix(in oklab, var(--sl-color-accent) 18%, transparent);
	}
	.code-tab-panel {
		display: none;
		margin: 0;
	}
	.code-tab-panel.active {
		display: block;
	}
	.code-tab-panel .code {
		margin: 0;
		padding: 0.5rem 1rem;
		background: var(--sl-color-gray-8);
		border: none;
		border-radius: 0;
	}
	.block-title {
		margin-block: 1rem 0.5rem;
		font-size: var(--sl-text-lg);
	}
	.params {
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
		font-variant-numeric: tabular-nums;
	}
	.params th,
	.params td {
		text-align: start;
		padding: 0.3rem 0.75rem;
		border-block-end: 1px solid var(--sl-color-gray-6);
	}
	/* Label column (taxa) keeps its natural width on the left; parameter columns
	   absorb the remaining width and fill the container on the right. Scoped to
	   data rows so the grouped header row's first column isn't affected. */
	.params.has-label tbody td:first-child {
		width: 1%;
		white-space: nowrap;
	}
	/* Group-header row (e.g. "Descriptors" / "Parameters") spanning its columns,
	   styled like the code-block tab bar. */
	.params .group-row {
		background: var(--sl-color-gray-7);
	}
	/* Group labels borrow the code-tab typography (small, muted, normal weight).
	   Explicit 400: the code-tab is a button (400), but group th cells inherit a
	   Starlight `th` rule that forces 600, so it must be overridden here. */
	.params .group {
		text-align: start;
		font-size: var(--sl-text-xs);
		font-weight: 400;
		line-height: 1;
		padding-block: 0.525rem;
		color: var(--sl-color-gray-3);
	}
	/* Parameter columns use a monospace face for aligned, data-like numerics. */
	.params .param-header,
	.params .param-num {
		font-family: var(--sl-font-mono, var(--sl-font-system-mono));
	}
	.code-block .hljs-number,
	.code .hljs-number {
		color: #d19a66;
	}
	.code-block .hljs-operator,
	.code .hljs-operator {
		color: #56b6c2;
	}
	.code-block .hljs-built_in,
	.code .hljs-built_in {
		color: #e5c07b;
	}
	.code-block .hljs-keyword,
	.code .hljs-keyword {
		color: #c678dd;
	}
	.code-block .hljs-string,
	.code .hljs-string {
		color: #98c379;
	}
	.code-block .hljs-comment,
	.code .hljs-comment {
		color: #7f848e;
	}
	.code-block .hljs-punctuation,
	.code .hljs-punctuation {
		color: inherit;
	}
	html[data-theme='light'] .code-block .hljs-number,
	html[data-theme='light'] .code .hljs-number {
		color: #986801;
	}
	html[data-theme='light'] .code-block .hljs-operator,
	html[data-theme='light'] .code .hljs-operator {
		color: #0184bc;
	}
	html[data-theme='light'] .code-block .hljs-built_in,
	html[data-theme='light'] .code .hljs-built_in {
		color: #c18401;
	}
	html[data-theme='light'] .code-block .hljs-keyword,
	html[data-theme='light'] .code .hljs-keyword {
		color: #a626a4;
	}
	html[data-theme='light'] .code-block .hljs-string,
	html[data-theme='light'] .code .hljs-string {
		color: #50a14f;
	}
	html[data-theme='light'] .code-block .hljs-comment,
	html[data-theme='light'] .code .hljs-comment {
		color: #a0a1a7;
	}
	.specs {
		border: 1px solid var(--sl-color-gray-6);
		border-radius: 0.375rem;
		overflow-x: auto;
	}
	.specs .params {
		display: table;
		margin: 0;
		width: 100%;
		border: none;
	}
	.code {
		background: var(--sl-color-gray-7);
		border: 1px solid var(--sl-color-gray-6);
		border-radius: 0.375rem;
		padding: 0.75rem 1rem;
		overflow-x: auto;
	}

	.kv {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.25rem 1rem;
		font-size: var(--sl-text-sm);
	}
	.kv-key {
		color: var(--sl-color-gray-3);
		font-weight: var(--sl-font-weight-semibold);
	}
</style>

<script>
	import { parse } from 'yaml';
	import vns from '../../lib/vns.json';
	import hljs from 'highlight.js/lib/core';
	import rLang from 'highlight.js/lib/languages/r';
	hljs.registerLanguage('r', rLang);

	const root = document.getElementById('publication');
	const status = document.getElementById('status');
	const yamlUrl = root.dataset.rawUrl;
	const pubId = root.dataset.pubId;
	const githubUrl = root.dataset.githubUrl;

	function el(tag, className, text) {
		const node = document.createElement(tag);
		if (className) node.className = className;
		if (text !== undefined) node.textContent = text;
		return node;
	}

	/** Initials from a given-name string: "George H" -> "GH", "T.M." -> "TM", "Chhun-Huor" -> "CH". */
	function initialsOf(given) {
		return given
			.split(/[\s.-]+/)
			.filter((word) => /[A-Za-z]/.test(word))
			.map((word) => word[0].toUpperCase())
			.join('');
	}

	/** Format a single "Last, Given Given" (or "Given Given Last") author as "Last, INITIALS". */
	function formatAuthor(raw) {
		const clean = raw.trim();
		const comma = clean.indexOf(',');
		if (comma !== -1) {
			const last = clean.slice(0, comma).trim();
			const initials = initialsOf(clean.slice(comma + 1));
			return initials ? `${last}, ${initials}` : last;
		}
		const words = clean.split(/\s+/);
		if (words.length <= 1) return clean;
		const last = words.pop();
		return `${last}, ${initialsOf(words.join(' '))}`;
	}

	/** Format an author string ("Last, Given and Last, Given") as "Last, INITIALS; Last, INITIALS". */
	function formatAuthors(author) {
		return String(author)
			.split(/\s+and\s+/i)
			.map((entry) => entry.trim())
			.filter(Boolean)
			.map(formatAuthor)
			.join('; ');
	}

	/** Venue from the BibTeX metadata: journal (article), institution (techreport), booktitle (proceedings). */
	function venueName(pub) {
		switch (pub.bibtype) {
			case 'article':
				return pub.journal;
			case 'techreport':
				return pub.institution;
			case 'inproceedings':
			case 'incollection':
				return pub.booktitle;
			default:
				return pub.journal ?? pub.institution ?? pub.booktitle;
		}
	}

	/** Normalize a scalar-or-array YAML value into a string array. */
	function asList(value) {
		if (Array.isArray(value)) return value.map((v) => String(v));
		if (value === undefined || value === null) return [];
		return [String(value)];
	}

	const MAX_VISIBLE = 5;

	/** Render "Label: a, b, ..." with a clickable ellipsis that reveals the rest. */
	function renderLine(label, items) {
		const p = el('p', 'pub-line');
		p.append(el('strong', 'label', `${label}: `));
		const list = asList(items);
		if (list.length === 0) {
			p.append(document.createTextNode('—'));
			return p;
		}
		if (list.length <= MAX_VISIBLE) {
			p.append(document.createTextNode(list.join(', ')));
			return p;
		}
		p.append(document.createTextNode(list.slice(0, MAX_VISIBLE).join(', ')));
		const btn = el('button', 'expand', '…');
		btn.type = 'button';
		btn.setAttribute('aria-expanded', 'false');
		btn.addEventListener('click', () => {
			const hidden = list.slice(MAX_VISIBLE);
			btn.replaceWith(document.createTextNode(hidden.join(', ')));
		});
		p.append(document.createTextNode(', '));
		p.append(btn);
		return p;
	}

	function renderPublication(pub) {
		const header = el('header', 'pub-header');
		header.append(el('h1', 'pub-title', pub.title ?? 'Untitled'));

		const meta = el('p', 'pub-meta');
		const nodes = [];
		const authors = formatAuthors(pub.author);
		if (authors) nodes.push(document.createTextNode(authors));
		if (pub.year) nodes.push(document.createTextNode(String(pub.year)));
		const venue = venueName(pub);
		if (venue) {
			// Journals are italicized in citations; institution/booktitle are plain.
			nodes.push(
				pub.bibtype === 'article' ? el('em', undefined, venue) : document.createTextNode(venue),
			);
		}
		if (pub.doi) {
			const link = document.createElement('a');
			link.href = pub.doi;
			link.target = '_blank';
			link.rel = 'noopener noreferrer';
			const match = pub.doi.match(/doi\.org\/(.+)$/);
			link.textContent = match ? match[1] : pub.doi;
			nodes.push(link);
		}
		// pub_id as a link to the YAML, bracketed at the end of the citation.
		if (pubId) {
			const pubLink = document.createElement('a');
			pubLink.href = githubUrl;
			pubLink.target = '_blank';
			pubLink.rel = 'noopener noreferrer';
			pubLink.textContent = `@${pubId}`;
			nodes.push(pubLink);
		}
		for (let i = 0; i < nodes.length; i++) {
			if (i > 0) meta.append(document.createTextNode('. '));
			meta.append(nodes[i]);
		}
		if (nodes.length > 0) meta.append(document.createTextNode('.'));
		header.append(meta);

		const descriptors = pub.descriptors ?? {};
		header.append(renderLine('Applicable Countries', descriptors.country));
		header.append(renderLine('Applicable Regions', descriptors.region));
		return header;
	}

	function renderModel(model) {
		const section = el('section', 'model');
		const head = el('div', 'model-head');
		head.append(el('h3', 'model-name', modelTitle(model, 'Model')));
		head.append(typeBadge('Model', 'model-type', 'A solitary prediction function with one set of parameters.'));
		section.append(head);

		if (model.response && typeof model.response === 'object') {
			const p = el('p', 'model-vars');
			p.append(el('strong', undefined, 'Response: '));
			appendVars(p, model.response);
			section.append(p);
		}
		if (model.covariates && typeof model.covariates === 'object') {
			const p = el('p', 'model-vars');
			p.append(el('strong', undefined, 'Covariates: '));
			appendVars(p, model.covariates);
			section.append(p);
		}
		if (model.prediction_function !== undefined && model.prediction_function !== null) {
			section.append(renderCodeTabs(model, 'model'));
		}
		if (model.parameters && typeof model.parameters === 'object') {
			const descNames =
				model.descriptors && typeof model.descriptors === 'object'
					? Object.keys(model.descriptors)
					: [];
			const paramNames = Object.keys(model.parameters);
			// "Descriptors" spans the label column (Taxa) plus any explicit descriptors;
			// "Parameters" spans the parameter columns.
			const groups = [
				{ label: 'Descriptors', count: descNames.length + 1 },
				{ label: 'Parameters', count: paramNames.length },
			];
			const headers = ['Taxa', ...descNames, ...paramNames];
			const row = [
				taxaLabel(model.taxa),
				...descNames.map((n) => model.descriptors[n] ?? ''),
				...paramNames.map((n) => formatParam(model.parameters[n])),
			];
			section.append(
				renderParamsTable(headers, [row], {
					labelFirstCol: true,
					groups,
					paramFrom: 1 + descNames.length,
				}),
			);
		}
		return section;
	}

	/** Render a `model_sets` entry: shared form plus an R prediction-function block. */
	function renderModelSet(set) {
		const section = el('section', 'model');
		const head = el('div', 'model-head');
		head.append(el('h3', 'model-name', modelTitle(set, 'Model set')));
		head.append(typeBadge('Model Set', 'set-type', 'A collection of models sharing the same functional form; parameter values vary per specification (e.g. one set per species).'));
		section.append(head);

		if (set.response && typeof set.response === 'object') {
			const p = el('p', 'model-vars');
			p.append(el('strong', undefined, 'Response: '));
			appendVars(p, set.response);
			section.append(p);
		}
		if (set.covariates && typeof set.covariates === 'object') {
			const p = el('p', 'model-vars');
			p.append(el('strong', undefined, 'Covariates: '));
			appendVars(p, set.covariates);
			section.append(p);
		}
		if (Array.isArray(set.specifications)) {
			const count = set.specifications.length;
			const p = el('p', 'model-vars');
			p.append(el('strong', undefined, 'Set Size: '));
			p.append(document.createTextNode(`${count} model${count === 1 ? '' : 's'}`));
			section.append(p);
		}
		if (set.prediction_function !== undefined && set.prediction_function !== null) {
			section.append(renderCodeTabs(set, 'set'));
		}
		if (Array.isArray(set.specifications) && set.specifications.length > 0) {
			section.append(renderSpecifications(set.specifications));
		}
		return section;
	}

	/** Syntax-highlight an R snippet, returning HTML-safe markup. */
	function highlightR(code) {
		return hljs.highlight(code, { language: 'r' }).value;
	}

	/** Wrap an R expression to a max line width, breaking at top-level operators. */
	function wrapLines(expr, width = 80) {
		let depth = 0;
		let line = '';
		const lines = [];
		const over = () => line.length >= width;
		for (let i = 0; i < expr.length; i++) {
			const ch = expr[i];
			if (ch === '(') depth++;
			if (ch === ')') depth--;
			line += ch;
			// semicolons separate statements: always break after one at top level.
			if (depth === 0 && ch === ';') {
				lines.push(line.trim());
				line = '';
				continue;
			}
			// break after an operator at any depth once the line is wide.
			if (/[+\-*/,]/.test(ch) && over() && i < expr.length - 1) {
				lines.push(line.trim());
				line = '';
			}
		}
		if (line.trim()) lines.push(line.trim());
		return lines;
	}

	/** Format a parameter value to two decimal places. */
	function formatParam(value) {
		const num = Number(value);
		if (!Number.isFinite(num)) return value === null || value === undefined ? '' : String(value);
		return num.toFixed(2);
	}

	/** Format a taxa list as "Genus species, …" (or "—" when empty). */
	function taxaLabel(taxa) {
		return (taxa ?? [])
			.map((t) => [t.genus, t.species].filter(Boolean).join(' '))
			.join(', ') || '—';
	}

	/** Render the per-taxon specifications as a self-scrolling table. */
	function renderSpecifications(specs) {
		// Union descriptor and parameter names across every spec → one column each.
		const descNames = [];
		const paramNames = [];
		for (const spec of specs) {
			if (spec.descriptors && typeof spec.descriptors === 'object') {
				for (const name of Object.keys(spec.descriptors)) {
					if (!descNames.includes(name)) descNames.push(name);
				}
			}
			if (spec.parameters && typeof spec.parameters === 'object') {
				for (const name of Object.keys(spec.parameters)) {
					if (!paramNames.includes(name)) paramNames.push(name);
				}
			}
		}
		// "Descriptors" spans the label column (Taxa) plus any explicit descriptors;
		// "Parameters" spans the parameter columns.
		const groups = [
			{ label: 'Descriptors', count: descNames.length + 1 },
			{ label: 'Parameters', count: paramNames.length },
		];
		const headers = ['Taxa', ...descNames, ...paramNames];
		const rows = specs.map((spec) => [
			taxaLabel(spec.taxa),
			...descNames.map((name) => spec.descriptors?.[name] ?? ''),
			...paramNames.map((name) =>
				spec.parameters?.[name] === undefined ? '' : formatParam(spec.parameters[name]),
			),
		]);
		return renderParamsTable(headers, rows, {
			labelFirstCol: true,
			groups,
			paramFrom: 1 + descNames.length,
		});
	}

	/**
	 * Render a self-scrolling `.specs > table.params` from column headers and data rows.
	 * Single source of truth for the Model (one row) and Model Set (per-spec) parameter
	 * tables, so both stay structurally consistent.
	 * @param {string[]} headers column labels, starting with the label column when
	 *   `labelFirstCol` (e.g. "Taxa") followed by descriptor/parameter columns
	 * @param {string[][]} rows  one array of formatted cell values per row
	 * @param {{ labelFirstCol?: boolean, groups?: {label: string, count: number}[],
	 *            paramFrom?: number }} [options]
	 *   `labelFirstCol` marks the first column as a natural-width label (e.g. taxa);
	 *   `groups` renders a group-header row (e.g. "Descriptors" / "Parameters") above
	 *   the column names, each spanning its columns; `paramFrom` is the index of the
	 *   first parameter column (styled monospace).
	 */
	function renderParamsTable(headers, rows, { labelFirstCol = false, groups = null, paramFrom = Infinity } = {}) {
		const container = el('div', 'specs');
		const table = el('table', labelFirstCol ? 'params has-label' : 'params');
		const thead = el('thead');

		if (groups && groups.length) {
			// Group-header row (e.g. "Descriptors" / "Parameters") spanning its columns.
			// The first group ("Descriptors") includes the label column (Taxa), so it
			// starts at the table's left edge and the band spans the full width.
			const groupRow = el('tr', 'group-row');
			for (const g of groups) {
				const th = el('th', 'group', g.label);
				th.colSpan = g.count;
				groupRow.append(th);
			}
			thead.append(groupRow);
		}

		const headRow = el('tr');
		headers.forEach((label, i) =>
			headRow.append(el('th', i >= paramFrom ? 'param-header' : undefined, label)),
		);
		thead.append(headRow);

		const tbody = el('tbody');
		for (const row of rows) {
			const tr = el('tr');
			row.forEach((value, i) =>
				tr.append(el('td', i >= paramFrom ? 'param-value param-num' : 'param-value', value)),
			);
			tbody.append(tr);
		}
		table.append(thead, tbody);
		container.append(table);
		return container;
	}

	/** Generic fallback for fields we don't render explicitly. */
	function renderUnknown(key, value) {
		const section = el('section', 'model');
		section.append(el('h3', 'model-name', key));
		const dl = el('dl', 'kv');
		appendKV(dl, value);
		section.append(dl);
		return section;
	}

	function appendKV(dl, value) {
		if (value && typeof value === 'object' && !Array.isArray(value)) {
			for (const [key, item] of Object.entries(value)) {
				dl.append(el('dt', 'kv-key', key));
				const dd = el('dd');
				if (item && typeof item === 'object') {
					appendKV(dl, item);
				} else {
					dd.textContent = Array.isArray(item) ? item.join(', ') : String(item ?? '');
					dl.append(dd);
				}
			}
		} else {
			const dd = el('dd');
			dd.textContent = Array.isArray(value) ? value.join(', ') : String(value ?? '');
			dl.append(dd);
		}
	}

	/** A hoverable variable-name span with a vns description tooltip. */
	function varTip(name) {
		const span = el('span', 'var-tip', name);
		const desc = vns.variables[name]?.description;
		if (desc) {
			span.dataset.desc = desc;
			span.classList.add('has-desc');
		}
		return span;
	}

	/** A categorical "Model"/"Model Set" badge with an explanatory tooltip. */
	function typeBadge(label, cls, desc) {
		const span = el('span', `badge type-badge ${cls}`, label);
		span.dataset.desc = desc;
		span.classList.add('has-desc');
		return span;
	}

	/** A tabbed code block. Each item: { label, code } (R, syntax-highlighted). */
	function codeTabs(items) {
		const container = el('div', 'code-tabs');
		const bar = el('div', 'code-tab-bar');
		const buttons = [];
		const panels = [];
		const activate = (i) => {
			buttons.forEach((btn, j) => btn.classList.toggle('active', j === i));
			panels.forEach((panel, j) => panel.classList.toggle('active', j === i));
		};
		items.forEach((item, i) => {
			const btn = el('button', 'code-tab' + (i === 0 ? ' active' : ''), item.label);
			btn.type = 'button';
			btn.addEventListener('click', () => activate(i));
			buttons.push(btn);
			bar.append(btn);
			const panel = el('div', 'code-tab-panel' + (i === 0 ? ' active' : ''));
			const pre = el('pre', 'code');
			const codeEl = el('code');
			codeEl.innerHTML = highlightR(item.code);
			pre.append(codeEl);
			panel.append(pre);
			panels.push(panel);
			container.append(panel);
		});
		container.prepend(bar);
		return container;
	}

	/**
	 * Build the Prediction Function / Load code tabs for a Model or Model Set.
	 * Shared so both emit identical R scaffolding. The Prediction Function tab
	 * shows the raw expression body (no function wrapper); the Load tab shows
	 * the loader call. Callers guard on prediction_function.
	 * @param {{name?: string, prediction_function: unknown}} record
	 * @param {'model'|'set'} kind
	 */
	function renderCodeTabs(record, kind) {
		const isSet = kind === 'set';
		const fnCode = wrapLines(String(record.prediction_function)).join('\n');
		const loadFn = isSet ? 'load_set' : 'load_model';
		const loadVar = isSet ? 'set' : 'model';
		const loadCode = `${loadVar} <- ${loadFn}("${pubId}", "${record.name ?? ''}")`;
		return codeTabs([
			{ label: 'Prediction Function', code: fnCode },
			{ label: isSet ? 'Load Set' : 'Load Model', code: loadCode },
		]);
	}

	/**
	 * vns-derived title shared by Model and Model Set: model_type when it matches,
	 * else "Measure - Component". Falls back to `type`/`name`, then `fallback`.
	 */
	function modelTitle(record, fallback) {
		const response =
			record.response && typeof record.response === 'object' ? Object.keys(record.response)[0] : null;
		if (response) {
			for (const [type, prefixes] of Object.entries(vns.model_types)) {
				if (prefixes.some((prefix) => response.startsWith(prefix))) return type;
			}
			const info = vns.variables[response];
			if (info) {
				const parts = [info.measure.charAt(0).toUpperCase() + info.measure.slice(1)].filter(Boolean);
				if (info.component) parts.push(info.component);
				if (parts.length > 0) return parts.join(' - ');
			}
		}
		return record.type ?? record.name ?? fallback;
	}

	/** Append `{variable (unit), variable (unit)}` with tooltips for each variable. */
	function appendVars(container, vars) {
		const entries = Object.entries(vars);
		for (let i = 0; i < entries.length; i++) {
			if (i > 0) container.append(document.createTextNode(', '));
			const [name, unit] = entries[i];
			container.append(varTip(name));
			if (typeof unit === 'string') container.append(document.createTextNode(` (${unit})`));
		}
	}

	function render(data) {
		const pub = data.publication ?? {};
		root.replaceChildren(renderPublication(pub));
		if (pub.title) document.title = `${pub.title} · Allometric`;

		if (Array.isArray(data.models)) {
			for (const model of data.models) root.append(renderModel(model));
		}
		if (Array.isArray(data.model_sets)) {
			for (const set of data.model_sets) root.append(renderModelSet(set));
		}
		for (const [key, value] of Object.entries(data)) {
			if (key === 'publication' || key === 'models' || key === 'model_sets') continue;
			root.append(renderUnknown(key, value));
		}
	}

	async function load() {
		try {
			status.textContent = 'Loading publication record…';
			const res = await fetch(yamlUrl);
			if (!res.ok) throw new Error(`HTTP ${res.status} ${res.statusText}`);
			const text = await res.text();
			render(parse(text));
		} catch (err) {
			status.textContent = `Failed to load YAML: ${err instanceof Error ? err.message : String(err)}`;
			status.className = 'status error';
		}
	}

	load();
</script>
