---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import '../../styles/content-page.css';
---

	<StarlightPage
		frontmatter={{
			title: 'Publications',
			description: 'Browse all publications in allometric/models by id, model type, measure, region, or year.',
			tableOfContents: false,
			prev: false,
			next: false,
		}}
	>
	<div class="pub-controls">
		<input id="pub-search" class="search-input" type="search" placeholder="Search by id, title, or author…" aria-label="Search publications" />
		<div class="view-switch" role="tablist" aria-label="Group publications by">
			<button data-mode="id" class="active" role="tab">ID</button>
			<button data-mode="type" role="tab">Model Type</button>
			<button data-mode="measure" role="tab">Measure</button>
			<button data-mode="region" role="tab">Region</button>
			<button data-mode="year" role="tab">Year</button>
		</div>
	</div>
	<div id="pub-groups" class="pub-groups">
		<p class="status">Loading publications…</p>
	</div>
</StarlightPage>

<style is:global>
	.pub-controls {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-block-end: 0.75rem;
	}
	.view-switch {
		display: inline-flex;
		gap: 0.25rem;
		padding: 0.25rem;
		background: var(--sl-color-gray-7);
		border: 1px solid var(--sl-color-gray-6);
		border-radius: 0.5rem;
	}
	.view-switch button {
		display: inline-flex;
		align-items: center;
		margin: 0;
		padding: 0.25rem 0.7rem;
		border: none;
		border-radius: 0.35rem;
		background: transparent;
		color: var(--sl-color-gray-3);
		font-family: inherit;
		font-size: var(--sl-text-xs);
		font-weight: var(--sl-font-weight-semibold);
		line-height: 1.4;
		cursor: pointer;
		white-space: nowrap;
	}
	.view-switch button:hover {
		color: var(--sl-color-text);
		background: color-mix(in oklab, var(--sl-color-gray-6) 40%, transparent);
	}
	.view-switch button.active {
		color: var(--sl-color-accent-high);
		background: color-mix(in oklab, var(--sl-color-accent) 18%, transparent);
	}
	.pub-groups {
		display: flex;
		flex-direction: column;
		flex: 0 1 auto;
		min-height: 0;
		margin-block-start: 0;
		overflow: auto;
		gap: 1.25rem;
	}
	.group h2 {
		font-size: var(--sl-text-lg);
		margin-block-start: 0;
		padding-block-start: 0;
		border-block-end: 1px solid var(--sl-color-gray-6);
		padding-block-end: 0.25rem;
	}
	.group-list {
		list-style: none;
		margin: 0;
		padding: 0;
		columns: 2;
		gap: 0 2.5rem;
	}
	.group-list li {
		padding: 0.2rem 0;
		font-size: var(--sl-text-sm);
		break-inside: avoid;
	}
	/* Two columns need ~640px; below that each pub gets the full width. */
	@media (max-width: 640px) {
		.group-list {
			columns: 1;
		}
	}
	.group-list .title {
		color: var(--sl-color-gray-3);
		margin-inline-start: 0.5rem;
	}
	.status,
	.empty {
		color: var(--sl-color-gray-4);
	}
</style>

<script>
	import pubs from '../../lib/publications.index.json';
	import models from '../../lib/models.index.json';
	import { typeLabel } from '../../lib/model-types';

	const groupsEl = document.getElementById('pub-groups');
	const searchEl = document.getElementById('pub-search');
	const viewBtns = [...document.querySelectorAll('.view-switch button')];
	// Derived model types per publication, from each pub's models.
	const pubTypes = new Map();
	for (const m of models) {
		const t = typeLabel(m);
		if (!pubTypes.has(m.pub_id)) pubTypes.set(m.pub_id, new Set());
		pubTypes.get(m.pub_id).add(t);
	}

	function el(tag, className, text) {
		const node = document.createElement(tag);
		if (className) node.className = className;
		if (text !== undefined) node.textContent = text;
		return node;
	}

	let mode = 'id';
	let query = '';

	function matches(pub) {
		if (!query) return true;
		return (
			(pub.id ?? '').toLowerCase().includes(query) ||
			(pub.title ?? '').toLowerCase().includes(query) ||
			(pub.authors ?? '').toLowerCase().includes(query)
		);
	}

	function groupBy() {
		const map = new Map();
		const add = (label, pub) => {
			if (!map.has(label)) map.set(label, []);
			map.get(label).push(pub);
		};
		for (const pub of pubs) {
			if (!matches(pub)) continue;
			switch (mode) {
				case 'id':
					add((pub.id[0] ?? '?').toUpperCase(), pub);
					break;
				case 'type': {
					const types = [...(pubTypes.get(pub.id) ?? [])];
					if (types.length === 0) types.push('Unclassified');
					for (const t of types) add(t, pub);
					break;
				}
				case 'measure': {
					const m = pub.measures.length ? pub.measures : ['Unclassified'];
					for (const x of m) add(x, pub);
					break;
				}
				case 'region': {
					const r = pub.regions.length ? pub.regions : ['Unclassified'];
					for (const x of r) add(x, pub);
					break;
				}
				case 'year': {
					const y = pub.year;
					add(y != null ? `${Math.floor(y / 10) * 10}s` : 'Unknown', pub);
					break;
				}
			}
		}
		return map;
	}

	function render() {
		const map = groupBy();
		const sorted = [...map.entries()].sort((a, b) =>
			a[0].localeCompare(b[0], undefined, { numeric: true }),
		);
		groupsEl.replaceChildren();
		if (sorted.length === 0) {
			groupsEl.append(el('p', 'empty', 'No publications match your search.'));
			return;
		}
		for (const [label, items] of sorted) {
			const section = el('section', 'group');
			section.append(el('h2', undefined, `${label} (${items.length})`));
			const ul = el('ul', 'group-list');
			for (const pub of items) {
				const li = el('li');
				const a = document.createElement('a');
				a.href = `/publications/${pub.id}/`;
				a.textContent = pub.id;
				li.append(a);
				if (pub.title) li.append(el('span', 'title', pub.title));
				ul.append(li);
			}
			section.append(ul);
			groupsEl.append(section);
		}
	}

	viewBtns.forEach((btn) =>
		btn.addEventListener('click', () => {
			mode = btn.dataset.mode;
			viewBtns.forEach((b) => b.classList.toggle('active', b === btn));
			render();
		}),
	);
	searchEl.addEventListener('input', () => {
		query = searchEl.value.trim().toLowerCase();
		render();
	});
	render();
</script>
