---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { REPO, listPublications, enrichWithTitles } from '../../lib/repo';

// Static listing of every publication in allometric/models, enumerated at
// build time (one GitHub trees API call per build — never at request time).
// Titles are read from each publication's YAML (raw CDN, no rate limit).
const pubs = await enrichWithTitles(await listPublications(), (data) => (data as any)?.publication?.title);

const byLetter = new Map<string, typeof pubs>();
for (const pub of pubs) {
	const letter = (pub.id[0] ?? '?').toUpperCase();
	if (!byLetter.has(letter)) byLetter.set(letter, []);
	byLetter.get(letter)!.push(pub);
}
const letters = [...byLetter.keys()].sort();
---

<StarlightPage
	frontmatter={{
		title: 'Publications',
		tableOfContents: false,
	}}
>
	<p class="count">
		{pubs.length} publications from{' '}
		<a href={`https://github.com/${REPO}`} target="_blank" rel="noopener noreferrer">
			{REPO}
		</a>
	</p>

	{
		letters.map((letter) => (
			<section class="letter-group">
				<h2>{letter}</h2>
				<ul>
					{byLetter.get(letter)!.map((pub) => (
						<li>
							<a href={`/publications/${pub.id}/`}>{pub.id}</a>
							{pub.title ? <>{' '}<span class="title">{pub.title}</span></> : null}
						</li>
					))}
				</ul>
			</section>
		))
	}
</StarlightPage>

<style>
	.count {
		color: var(--sl-color-gray-4);
		font-size: var(--sl-text-sm);
		margin-block-end: 1.5rem;
	}
	.letter-group {
		margin-block-end: 1.5rem;
	}
	.letter-group h2 {
		font-size: var(--sl-text-xl);
		border-block-end: 1px solid var(--sl-color-gray-6);
		padding-block-end: 0.25rem;
	}
	.letter-group ul {
		list-style: none;
		margin: 0;
		padding: 0;
		columns: 2;
		gap: 0 2.5rem;
	}
	.letter-group li {
		padding: 0.25rem 0;
		font-size: var(--sl-text-sm);
		break-inside: avoid;
	}
	.title {
		color: var(--sl-color-gray-3);
		margin-inline-start: 0.5rem;
	}
</style>

<style is:global>
	/* Without a right-side TOC, lucode drops the constrained content column and the
	   listing stretches edge-to-edge. Restore the comfortable 40rem-centered column. */
	main main:has(.letter-group) {
		max-width: var(--content-max-width);
		margin-inline: auto;
	}
</style>
